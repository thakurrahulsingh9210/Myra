# Myra PC settings. Copy to .env locally; never commit real credentials.
MYRA_RUN_MODE=hybrid
MYRA_PRIMARY_LANGUAGE=hi-IN
MYRA_SECONDARY_LANGUAGE=en-IN
MYRA_DATABASE_PATH=~/.myra/tasks.sqlite3
MYRA_LOG_LEVEL=INFO

# Provider credentials are intentionally not defined in this starter.
# Keep provider secrets in Windows Credential Manager or another secure store.
