# Myra PC settings. Copy to .env locally; never commit real credentials.
MYRA_RUN_MODE=hybrid
MYRA_PRIMARY_LANGUAGE=hi-IN
MYRA_SECONDARY_LANGUAGE=en-IN
MYRA_DATABASE_PATH=~/.myra/tasks.sqlite3
MYRA_LOG_LEVEL=INFO
MYRA_WHISPER_MODEL_PATH=~/.myra/models/faster-whisper-small
MYRA_OPENAI_STT_MODEL=gpt-4o-mini-transcribe
MYRA_OPENAI_TTS_MODEL=gpt-4o-mini-tts
MYRA_OPENAI_TTS_VOICE=alloy

# Set API keys through Windows Credential Manager or process environment.
# OPENAI_API_KEY is intentionally not stored in this file.
